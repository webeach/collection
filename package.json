{
  "name": "@webeach/collection",
  "version": "1.3.0",
  "description": "Managed collection of items with hooks, events, and strict type safety",
  "keywords": [
    "collection",
    "dataset",
    "event-driven",
    "evented",
    "hookable",
    "library",
    "list",
    "typed-collection",
    "typed-list",
    "typescript",
    "webeach"
  ],
  "homepage": "https://github.com/webeach/collection",
  "bugs": {
    "url": "https://github.com/webeach/collection/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Ruslan Martynov",
    "email": "github@webea.ch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webeach/collection"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "browser": "./dist/browser/index.js",
  "types": "./dist/cjs/index.d.cts",
  "unpkg": "./dist/browser/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "scan": "dist-guard",
    "size": "size-limit",
    "release": "semantic-release",
    "prepare": "is-ci || husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@size-limit/file": "^12.1.0",
    "@webeach/dist-guard": "^0.2.1",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^17.0.5",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "semantic-release": "^25.0.3",
    "size-limit": "^12.1.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "**/*.{cjs,cts,js,jsx,mjs,mts,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "**/*.json": [
      "oxfmt"
    ]
  },
  "size-limit": [
    {
      "path": "./dist/browser/index.js",
      "limit": "1.5 KB"
    }
  ],
  "engines": {
    "node": ">=18.0.0",
    "pnpm": "^10"
  },
  "packageManager": "pnpm@10.7.1"
}
